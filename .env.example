# === Required runtime variables (injected by evaluator or local run) ===
MODEL_NAME=gemini-4-argon
MODEL_BASE_URL=http://localhost:4000/v1
MODEL_API_KEY=replace-with-your-model-proxy-or-api-key

# Optional alternate OpenAI / Gemini SDK fallback endpoints
# OPENAI_BASE_URL=http://localhost:4000/v1
# OPENAI_API_KEY=replace-with-key
# GOOGLE_GEMINI_BASE_URL=http://localhost:4000
# GEMINI_API_KEY=replace-with-key

# === Model tuning & context limits (override harness_config.json) ===
# REASONING_EFFORT=high
# MAX_OUTPUT_TOKENS=32000
# COMPACT_AT_TOKENS=150000

# === Phase budgets (override harness_config.json) ===
# AURA_CONFIG_PATH=/opt/harness/src/harness_config.json
# AURA_VERIFY_SHARE=0.30
# AURA_MAX_REPAIR_ROUNDS=3

# === Structured telemetry (written only to writable sandbox dirs such as /tmp) ===
# AURA_TELEMETRY_ENABLED=true
# AURA_TELEMETRY_PATH=/tmp/aura_telemetry.jsonl
# AURA_SUMMARY_PATH=/tmp/aura_summary.json

# === Local PLE benchmark runner variables (never committed inside repo) ===
# MODEL_PROXY_URL=http://localhost:4000
# MODEL_PROXY_KEY=replace-with-proxy-master-key
# JUDGE_BASE_URL=http://host.docker.internal:4000/v1
# JUDGE_API_KEY=replace-with-judge-key
# JUDGE_MODEL=gemini-4-argon-judge
# HF_TOKEN=replace-with-huggingface-read-token
